  "private": true,
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.0",
    "@vinext/cloudflare": "^1.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-91c870c02",
